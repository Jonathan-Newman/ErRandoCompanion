<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Core\ErRandoCompanion.Core.csproj" />
    <ProjectReference Include="..\GameReader\ErRandoCompanion.GameReader.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Data\*.json" Link="Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Data\*.jpg" Link="Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\LICENSE;..\THIRD_PARTY_NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ErRandoCompanion</AssemblyName>
    <RootNamespace>ErRandoCompanion.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Elden Ring Randomizer Companion</Product>
    <AssemblyTitle>Elden Ring Randomizer Companion</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
