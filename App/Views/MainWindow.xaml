<Window x:Class="ErRandoCompanion.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ErRandoCompanion.App.ViewModels"
        xmlns:views="clr-namespace:ErRandoCompanion.App.Views"
        Title="Elden Ring Randomizer Companion"
        Width="1280" Height="860" MinWidth="900" MinHeight="520"
        Background="{StaticResource Background}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <views:EnumEqualsConverter x:Key="EnumEquals" />

        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type vm:ItemViewModel}">
            <Grid Margin="2" IsEnabled="{Binding IsRelevant}" ToolTip="{Binding Notes}">
                <ToggleButton IsChecked="{Binding IsOwned}" Padding="9,5" MinHeight="40"
                              AutomationProperties.Name="{Binding Name}"
                              HorizontalContentAlignment="Left"
                              Visibility="{Binding IsSingle, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12" />
                </ToggleButton>
                <Border Background="{StaticResource PanelRaised}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="4"
                        Padding="9,3,5,3" MinHeight="40"
                        Visibility="{Binding IsCounted, Converter={StaticResource Visible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="+" Width="22" Height="22" Padding="0" Margin="2,0,0,0" VerticalAlignment="Center"
                                Command="{Binding Increase}" AutomationProperties.Name="{Binding Name, StringFormat='More {0}'}" />
                        <Button DockPanel.Dock="Right" Content="-" Width="22" Height="22" Padding="0" Margin="2,0,0,0" VerticalAlignment="Center"
                                Command="{Binding Decrease}" AutomationProperties.Name="{Binding Name, StringFormat='Fewer {0}'}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource GoldBright}"
                                   VerticalAlignment="Center" Margin="4,0" FontSize="12" />
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ItemGrid">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <DockPanel Margin="16,12,16,14">
        <!-- Title, seed and overall progress. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Width="280">
                <TextBlock Text="{Binding Summary}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,5" />
                <ProgressBar Maximum="{Binding TotalCount}" Value="{Binding DoneCount, Mode=OneWay}" Height="5" />
            </StackPanel>
            <TextBlock Text="Rando Companion" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBright}" VerticalAlignment="Center" Margin="0,0,24,0" />
            <ComboBox Width="190" IsEditable="True" VerticalAlignment="Center"
                      AutomationProperties.Name="Seed name"
                      ItemsSource="{Binding SeedNames}"
                      Text="{Binding SeedInput, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Open / New" Margin="6,0,0,0" VerticalAlignment="Center" Command="{Binding OpenSeed}" />
            <Button Content="Delete" Margin="6,0,0,0" VerticalAlignment="Center" Click="OnDeleteSeed"
                    ToolTip="Delete the saved run named in the seed box (a backup is kept)" />
            <Button Content="Backups..." Margin="6,0,0,0" VerticalAlignment="Center" Click="OnBackups"
                    ToolTip="Put a run back as it was earlier, or bring back a deleted run" />
            <TextBlock Text="{Binding CurrentSeed, StringFormat='Tracking: {0}'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </DockPanel>

        <!-- Link to the game. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
            <DockPanel>
                <Button Content="Load spoiler log..." VerticalAlignment="Center" Click="OnLoadSpoilerLog" />
                <Button Content="Randomizer folder..." Margin="6,0,0,0" VerticalAlignment="Center" Click="OnChooseRandomizerFolder"
                        ToolTip="Pick the randomizer folder once and new seeds are picked up after each randomize" />
                <TextBlock Text="{Binding SpoilerStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,16,0"
                           ToolTip="{Binding SpoilerStatus}" />
                <CheckBox DockPanel.Dock="Right" Content="Auto-track" IsChecked="{Binding AutoTrack}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Text="{Binding GameStatus}" FontWeight="SemiBold" Foreground="{StaticResource GoldBright}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameStatus}" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource ProblemWash}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Problem}" TextWrapping="Wrap" />
        </Border>

        <!-- Shown while the in-game overlay owns the open run, so this window only follows it. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource GoldWash}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ReadOnlyNotice}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ReadOnlyNotice}" Foreground="{StaticResource GoldBright}" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <!-- Targets: what the player is hunting, numbered 1 to 5. -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding GraceHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Visibility="{Binding HasGraceHint, Converter={StaticResource Visible}}" />
                        <TextBlock Text="Targets" Style="{StaticResource Heading}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="Right-click a check or map pin to make it target 1 to 5." FontSize="11"
                                   VerticalAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Targets.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Targets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Chip" CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource Line}"
                                            Background="{StaticResource PanelRaised}" Padding="2,2,4,2" Margin="0,2,6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource TargetBadge}" Cursor="Hand"
                                                    ToolTip="The guide arrow follows the highlighted target. Click a number to follow that one.">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding Follow}" />
                                                </Border.InputBindings>
                                                <TextBlock Text="{Binding TargetNumber}" Style="{StaticResource TargetBadgeText}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0,6,0" MaxWidth="220"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RegionName}" />
                                            <Button Style="{StaticResource SmallButton}" Content="Map" Margin="0,0,3,0" Command="{Binding ShowOnMap}"
                                                    Visibility="{Binding HasPin, Converter={StaticResource Visible}}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat='Show {0} on map'}" />
                                            <Button Style="{StaticResource SmallButton}" Content="x" Command="{Binding ClearTarget}"
                                                    ToolTip="Clear this target" AutomationProperties.Name="{Binding Name, StringFormat='Clear target {0}'}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsActiveTarget}" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Gold}" />
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource GoldWash}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                        Background="{StaticResource GoldWash}" Visibility="{Binding HasDeadEnd, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding DeadEnd}" Foreground="{StaticResource GoldBright}" TextWrapping="Wrap" />
                </Border>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Style="{StaticResource Pill}" Content="Available"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Available}" />
                    <RadioButton Style="{StaticResource Pill}" Content="Checked"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Checked}" />
                    <RadioButton Style="{StaticResource Pill}" Content="Locked"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Locked}" />
                    <RadioButton Style="{StaticResource Pill}" Content="All"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                </StackPanel>

                <TabControl SelectedIndex="{Binding MainTab}">
                    <TabItem Header="Checklist">
                        <ScrollViewer x:Name="ChecklistScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RegionList" ItemsSource="{Binding Regions}" Margin="0,0,6,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,8"
                                                  Visibility="{Binding IsVisible, Converter={StaticResource Visible}}">
                                            <Expander.Header>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,2,0" />
                                                    <ProgressBar DockPanel.Dock="Right" Width="90" Maximum="{Binding Total}" Value="{Binding Done, Mode=OneWay}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}" />
                                                </DockPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Locations}" Margin="10,0,10,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="Row" Padding="8,6" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent"
                                                                Background="Transparent"
                                                                Visibility="{Binding IsVisible, Converter={StaticResource Visible}}">
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Target 1" Command="{Binding SetTarget}" CommandParameter="1" />
                                                                    <MenuItem Header="Target 2" Command="{Binding SetTarget}" CommandParameter="2" />
                                                                    <MenuItem Header="Target 3" Command="{Binding SetTarget}" CommandParameter="3" />
                                                                    <MenuItem Header="Target 4" Command="{Binding SetTarget}" CommandParameter="4" />
                                                                    <MenuItem Header="Target 5" Command="{Binding SetTarget}" CommandParameter="5" />
                                                                    <Separator />
                                                                    <MenuItem Header="Clear target" Command="{Binding ClearTarget}" IsEnabled="{Binding IsTarget}" />
                                                                    <Separator />
                                                                    <MenuItem Header="{Binding SkipLabel}" Command="{Binding ToggleSkip}" />
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Map" Margin="10,0,0,0" VerticalAlignment="Top"
                                                                        Command="{Binding ShowOnMap}" Visibility="{Binding HasPin, Converter={StaticResource Visible}}"
                                                                        AutomationProperties.Name="{Binding Name, StringFormat='Show {0} on map'}" />
                                                                <TextBlock x:Name="StatusLabel" DockPanel.Dock="Right" Text="{Binding Status}" Width="62" TextAlignment="Right"
                                                                           FontSize="11" FontWeight="SemiBold" Margin="8,2,0,0" Foreground="{StaticResource StatusAvailable}" />
                                                                <TextBlock DockPanel.Dock="Right" Text="skipped" FontSize="11" Margin="8,2,0,0" Style="{StaticResource Muted}"
                                                                           ToolTip="Put aside for now: right-click to unskip."
                                                                           Visibility="{Binding ShowsSkipped, Converter={StaticResource Visible}}" />
                                                                <Border DockPanel.Dock="Left" Style="{StaticResource TargetBadge}" Margin="0,0,8,0" VerticalAlignment="Top"
                                                                        ToolTip="Target. Right-click to change it."
                                                                        Visibility="{Binding IsTarget, Converter={StaticResource Visible}}">
                                                                    <TextBlock Text="{Binding TargetNumber}" Style="{StaticResource TargetBadgeText}" />
                                                                </Border>
                                                                <CheckBox x:Name="Tick" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}"
                                                                          AutomationProperties.Name="{Binding Name}">
                                                                    <StackPanel>
                                                                        <TextBlock x:Name="NameText" Text="{Binding Name}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </CheckBox>
                                                            </DockPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelRaised}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Locked">
                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource StatusLocked}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Checked">
                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource StatusChecked}" />
                                                                <Setter TargetName="NameText" Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource TextMuted}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Excluded">
                                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource StatusExcluded}" />
                                                                <Setter TargetName="Tick" Property="Opacity" Value="0.5" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Gold}" />
                                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource GoldWash}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Map">
                        <views:MapView x:Name="MapPane" DataContext="{Binding Map}" />
                    </TabItem>

                    <TabItem Header="All checks" DataContext="{Binding AllChecks}">
                        <DockPanel Margin="2,0,6,0">
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"
                                       Text="Every place the randomizer could put an item in this seed: pickups, chests, enemy drops, boss rewards, quests and shops. Open and locked follow the randomizer's own logic. It says where each check is and what the unrandomized game had there, never what it holds now. Ticks here are kept apart from the Checklist." />
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Message}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Foreground="{StaticResource GoldBright}" Margin="0,0,0,8" />
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <ComboBox DockPanel.Dock="Left" Width="100" AutomationProperties.Name="Which checks"
                                          ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
                                <ComboBox DockPanel.Dock="Left" Width="120" Margin="8,0,0,0" AutomationProperties.Name="Kind of check"
                                          ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" />
                                <TextBox Margin="8,0,0,0" AutomationProperties.Name="Search all checks"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox ItemsSource="{Binding Places}" SelectedItem="{Binding Place}" Background="Transparent" BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="Places">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Counts}" Style="{StaticResource Muted}" FontSize="11" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <ListBox Grid.Column="1" Margin="10,0,0,0" ItemsSource="{Binding Visible}" Background="Transparent" BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Checks">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,6">
                                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,8,0" IsChecked="{Binding IsChecked}"
                                                          AutomationProperties.Name="{Binding Description}" />
                                                <StackPanel>
                                                    <TextBlock x:Name="What" Text="{Binding Description}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Check.Place}" Style="{StaticResource Muted}" FontSize="11" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="Odds" Text="{Binding Odds}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Odds}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Available">
                                                    <Setter TargetName="What" Property="Foreground" Value="{StaticResource StatusAvailable}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Locked">
                                                    <Setter TargetName="What" Property="Foreground" Value="{StaticResource StatusLocked}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Checked">
                                                    <Setter TargetName="What" Property="Foreground" Value="{StaticResource StatusChecked}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter TargetName="Odds" Property="Foreground" Value="{StaticResource GoldBright}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Found">
                        <DockPanel Margin="2,0,6,0">
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"
                                       Text="Everything you have picked up in this run, newest first, and where. Only pickups you have already made show here. Needs the run's spoiler log. Random drops, purchases and crafting show as &quot;Drop or other&quot;." />
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <ComboBox DockPanel.Dock="Left" Width="140" AutomationProperties.Name="Kind of item"
                                          ItemsSource="{Binding FoundKinds}" SelectedItem="{Binding FoundFilter}" />
                                <TextBox Margin="8,0,0,0" AutomationProperties.Name="Search found items"
                                         Text="{Binding FoundSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Found}" VirtualizingPanel.IsVirtualizing="True" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Items}" Foreground="{StaticResource GoldBright}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Where}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Progress">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2,0,6,0">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"
                                           Text="Open means available and not skipped. Splits compare each step with the same step of your best finished run with this goal. Right-click a check to skip it for now." />
                                <ItemsControl ItemsSource="{Binding Progress}">
                                    <ItemsControl.ItemTemplate>
                                    <DataTemplate>
    <StackPanel Margin="0,0,0,12">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Run goal">
                        <StackPanel Margin="2,0,6,0">
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"
                                       Text="Pick what finishes this run. When it is met the run is marked complete and its timer stops; untick something and it carries on." />
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Goal" VerticalAlignment="Center" Width="90" />
                                <ComboBox MinWidth="300" AutomationProperties.Name="Run goal"
                                          ItemsSource="{Binding GoalKinds}" DisplayMemberPath="Name" SelectedValuePath="Kind"
                                          SelectedValue="{Binding GoalKind}" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10" Visibility="{Binding GoalCounts, Converter={StaticResource Visible}}">
                                <TextBlock Text="How many" VerticalAlignment="Center" Width="90" />
                                <TextBox Width="60" AutomationProperties.Name="How many"
                                         Text="{Binding GoalCount, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Text="Leave empty for all of them." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </DockPanel>
                            <TextBlock Text="{Binding GoalProgress}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource GoldBright}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                            <!-- The bosses for "defeat bosses I choose". Each counts wherever the randomizer put it; where is never shown. -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding ChoosesBosses, Converter={StaticResource Visible}}">
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Tick the bosses this run needs. Each counts when you defeat that boss, wherever the randomizer put it." />
                                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding MajorBossChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Right" Text="defeated" Foreground="{StaticResource GoldBright}" Margin="8,0,0,0"
                                                                   Visibility="{Binding Defeated, Converter={StaticResource Visible}}" />
                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChosen}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Expander Header="Other bosses" Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding OtherBossChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock DockPanel.Dock="Right" Text="defeated" Foreground="{StaticResource GoldBright}" Margin="8,0,0,0"
                                                                       Visibility="{Binding Defeated, Converter={StaticResource Visible}}" />
                                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChosen}" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="History">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2,0,6,0">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,12"
                                           Text="Finished runs, newest first. A run finishes when its goal is met; the best time for each goal is marked." />
                                <TextBlock Text="No finished runs yet.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding History.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="best" Foreground="{StaticResource GoldBright}" FontWeight="SemiBold"
                                                               Visibility="{Binding Best, Converter={StaticResource Visible}}" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                                <Expander Header="Summary" Margin="0,4,0,0">
                                                    <ItemsControl ItemsSource="{Binding Report}" Margin="12,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                <DataTemplate>
    <StackPanel Margin="0,0,0,12">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding Lines}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <TabControl>
                    <TabItem Header="Items">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="2,0,2,10"
                                           Text="With a spoiler log and auto-track on, items you collect are marked for you. Otherwise, mark what you actually found: looting the place an item normally sits counts as a check, not as owning it." />
                                <!-- What each missing item would open: the logic's answer to "what if I had it", never where it is. -->
                                <TextBlock Text="What each missing item would open now" Style="{StaticResource Heading}" Margin="2,0,0,5" />
                                <ItemsControl ItemsSource="{Binding Unlocks}" Margin="2,0,2,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource GoldBright}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Key items" Style="{StaticResource Heading}" Margin="2,0,0,5" />
                                <ItemsControl ItemsSource="{Binding KeyItems}" ItemTemplate="{StaticResource ItemTemplate}"
                                              ItemsPanel="{StaticResource ItemGrid}" />
                                <TextBlock Text="Alternate routes and shortcuts" Style="{StaticResource Heading}" Margin="2,14,0,5" />
                                <ItemsControl ItemsSource="{Binding ShortcutItems}" ItemTemplate="{StaticResource ItemTemplate}"
                                              ItemsPanel="{StaticResource ItemGrid}" />
                                <Expander Margin="0,14,0,0" Header="Other quest items (no effect on logic)">
                                    <ItemsControl ItemsSource="{Binding OtherItems}" ItemTemplate="{StaticResource ItemTemplate}"
                                                  ItemsPanel="{StaticResource ItemGrid}" Margin="6,0,6,8" />
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Randomizer settings">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" Margin="2,0,2,12"
                                           Text="Loading a spoiler log fills in what it can. Check the rest against your randomizer setup. Spirit spring randomization is not part of the logic." />
                                <ItemsControl ItemsSource="{Binding Settings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,0,2,11">
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding BoolValue}"
                                                          Visibility="{Binding IsBool, Converter={StaticResource Visible}}" />
                                                <DockPanel Visibility="{Binding IsList, Converter={StaticResource Visible}}">
                                                    <ComboBox DockPanel.Dock="Right" MinWidth="76" Margin="8,0,0,0"
                                                              AutomationProperties.Name="{Binding Name}"
                                                              ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                              SelectedValue="{Binding ListValue}" />
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                                                           Visibility="{Binding HasNotes, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
